APP_NAME=POS_ALEXING
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/pos_alexing

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_alexing
DB_USERNAME=root
DB_PASSWORD=
DB_ENCODE=utf8

# Zona horaria
APP_TIMEZONE=America/Lima

# Configuración regional
APP_LOCALE=es_PE
APP_CURRENCY=PEN

# Sesiones
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Logs
LOG_CHANNEL=file
LOG_LEVEL=debug

# Correo (SMTP)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp API (opcional)
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# JWT (opcional)
JWT_SECRET=

# API Keys (opcionales)
API_KEY=
API_SECRET=